<Window x:Class="PWSV.Client.Views.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PWSV.Client.Converters"
        Title="Зміна пароля" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Зміна пароля" Style="{StaticResource HeadingTextStyle}" />
                <TextBlock Text="Майстер-пароль при цьому не змінюється"
                           Style="{StaticResource SubtitleTextStyle}" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource ErrorBannerStyle}"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource ErrorHoverBrush}"
                           TextWrapping="Wrap" />
            </Border>

            <StackPanel Grid.Row="2">
                <TextBlock Text="Поточний пароль" Style="{StaticResource LabelTextStyle}" />
                <PasswordBox PasswordChar="•" TabIndex="0"
                             PasswordChanged="OldPasswordBox_OnPasswordChanged" />

                <TextBlock Text="Новий пароль (мін. 8, мала й велика літери, цифра)" Style="{StaticResource LabelTextStyle}" />
                <PasswordBox PasswordChar="•" TabIndex="1"
                             PasswordChanged="NewPasswordBox_OnPasswordChanged" />

                <TextBlock Text="Підтвердження нового пароля" Style="{StaticResource LabelTextStyle}" />
                <PasswordBox PasswordChar="•" TabIndex="2"
                             PasswordChanged="ConfirmPasswordBox_OnPasswordChanged" />
            </StackPanel>

            <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,16,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Скасувати" Click="OnCancelClick"
                            Style="{StaticResource SecondaryButtonStyle}" TabIndex="4" />
                    <Button Content="Змінити пароль" Command="{Binding SaveCommand}"
                            IsDefault="True" TabIndex="3" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
